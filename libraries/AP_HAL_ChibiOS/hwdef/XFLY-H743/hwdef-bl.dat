MCU STM32H7xx STM32H743xx

# crystal frequency
OSCILLATOR_HZ 8000000

APJ_BOARD_ID 8888


FLASH_SIZE_KB 2048
env OPTIMIZE -O2

# bootloader partition
FLASH_RESERVE_START_KB 0

FLASH_BOOTLOADER_LOAD_KB 64

# ChibiOS system timer
STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32
define CH_CFG_ST_FREQUENCY 100000

# serial ports
SERIAL_ORDER OTG1 UART5 USART3

PD8 USART3_TX USART3
PD9 USART3_RX USART3

PB13 UART5_TX UART5
PB12 UART5_RX UART5

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PC2 LED_RED OUTPUT PUSHPULL LOW
PC3 LED_ACTIVITY OUTPUT PUSHPULL LOW
PC15 LED_BOOTLOADER OUTPUT PUSHPULL LOW

define HAL_LED_ON 1                   # LEDs are active high

PC13 IMU1_CS CS
PE3 AT7456E_CS CS
PA4 IMU2_CS CS
PB0 IMU3_CS CS

# SD card
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

define HAL_OS_FATFS_IO 1
define AP_BOOTLOADER_FLASH_FROM_SD_ENABLED 1

# FATFS support:
define CH_CFG_USE_MEMCORE 1
define CH_CFG_USE_HEAP 1
define CH_CFG_USE_SEMAPHORES 0
define CH_CFG_USE_MUTEXES 1
define CH_CFG_USE_DYNAMIC 1
define CH_CFG_USE_WAITEXIT 1
define CH_CFG_USE_REGISTRY 1