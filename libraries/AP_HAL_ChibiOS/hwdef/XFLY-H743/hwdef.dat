MCU STM32H7xx STM32H743xx
APJ_BOARD_ID 8888

DEFAULTS defaults.parm

OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

env OPTIMIZE -Os

FLASH_RESERVE_START_KB 128

STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PC2 LED_RED OUTPUT LOW GPIO(34)
PC3 LED_ACT OUTPUT LOW GPIO(35)
PC15 BOOTLOADER OUTPUT LOW GPIO(47)

define HAL_GPIO_A_LED_PIN 35
define HAL_GPIO_B_LED_PIN 34
define HAL_GPIO_C_LED_PIN 47
define HAL_GPIO_LED_ON 1
define AP_NOTIFY_GPIO_LED_3_ENABLED 1


PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4

PE3 AT7456E_CS CS
PC13 IMU1_CS CS

PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

PA4 IMU2_CS CS
PB0 IMU3_CS CS

I2C_ORDER I2C2 I2C4 

PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4


PB1 HEATER_EN OUTPUT LOW GPIO(17)
define HAL_HEATER_GPIO_PIN 17
define HAL_HAVE_IMU_HEATER 1
define HAL_IMU_TEMP_DEFAULT 45

# order of UARTs (and USB) - fork convention: SERIALn == chip UARTn,
# with EMPTY placeholders for the UARTs this board does not bring out
SERIAL_ORDER OTG1 USART1 USART2 USART3 EMPTY UART5 EMPTY UART7 UART8

PD5 USART2_TX USART2
PD6 USART2_RX USART2

PD8 USART3_TX USART3
PD9 USART3_RX USART3

PA9 USART1_TX USART1
PA10 USART1_RX USART1

PE1 UART8_TX UART8
PE0 UART8_RX UART8

PE7 UART7_RX UART7
PE8 UART7_TX UART7

PB13 UART5_TX UART5
PB12 UART5_RX UART5

PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PD3 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(51)

PE9   TIM1_CH1 TIM1 PWM(1)  GPIO(73)  
PE11  TIM1_CH2 TIM1 PWM(2)  GPIO(75)  
PE13  TIM1_CH3 TIM1 PWM(3)  GPIO(77)  
PE14  TIM1_CH4 TIM1 PWM(4)  GPIO(78)  

PB7   TIM4_CH2 TIM4 PWM(5)  GPIO(23)  
PB6   TIM4_CH1 TIM4 PWM(6)  GPIO(22)  
PB5   TIM3_CH2 TIM3 PWM(7)  GPIO(21)  
PB4   TIM3_CH1 TIM3 PWM(8)  GPIO(20)  

PB14  TIM12_CH1 TIM12 PWM(9) GPIO(30) NODMA
PB15  TIM12_CH2 TIM12 PWM(10) GPIO(31) NODMA
PC6   TIM8_CH1 TIM8 PWM(11)  GPIO(38) 
PC7   TIM8_CH2 TIM8 PWM(12)  GPIO(39) 

PA0   TIM2_CH1 TIM2 PWM(13)  GPIO(0)  
PA1   TIM2_CH2 TIM2 PWM(14)  GPIO(1)  
PA2   TIM2_CH3 TIM2 PWM(15)  GPIO(2)  
PA3   TIM2_CH4 TIM2 PWM(16)  GPIO(3)

PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC0 BATT_CURRENT_SENS ADC1 SCALE(1)
PC4 BATT_SERVO_SENS ADC1 SCALE(1)
PC5 BATT_IMU_SENS ADC1 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_CURR_PIN 10
define HAL_BATT_VOLT_SCALE 11
define HAL_BATT_CURR_SCALE 33.33

define HAL_BATT2_MONITOR_DEFAULT 4
define HAL_BATT2_VOLT_PIN 4
define HAL_BATT2_CURR_PIN 8
define HAL_BATT2_VOLT_SCALE 3.2
define HAL_BATT2_CURR_SCALE 1.0

# Q_ENABLE and SCHED_LOOP_RATE are parameter defaults - see defaults.parm

PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

DMA_PRIORITY S*
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

SPIDEV osd           SPI4 DEVID1 AT7456E_CS   MODE0  10*MHZ 10*MHZ

SPIDEV icm42688_2  SPI1 DEVID1 IMU2_CS  MODE3  2*MHZ 16*MHZ
SPIDEV icm42688_1  SPI4 DEVID1 IMU1_CS  MODE3  2*MHZ 16*MHZ 

DMA_NOSHARE  SPI1* SPI4*

define AP_COMPASS_PROBING_ENABLED 1
define AP_COMPASS_IST8310_EXTERNAL_BUS_PROBING_ENABLED 0
define AP_COMPASS_IST8310_INTERNAL_BUS_PROBING_ENABLED 0

COMPASS IST8310 I2C:ALL_EXTERNAL:0x0E true  ROTATION_ROLL_180_YAW_90
COMPASS IST8310 I2C:ALL_INTERNAL:0x0E false ROTATION_YAW_180

IMU Invensensev3 SPI:icm42688_2 ROTATION_YAW_270
IMU Invensensev3 SPI:icm42688_1 ROTATION_ROLL_180_YAW_90

define HAL_DEFAULT_INS_FAST_SAMPLE 1

BARO DPS310 I2C:0:0x76
BARO DPS310 I2C:1:0x76

define HAL_OS_FATFS_IO 1

define OSD_ENABLED 1
define OSD_PARAM_ENABLED 1     
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

define AP_OSD_LINK_STATS_EXTENSIONS_ENABLED 1
define HAL_OSD_SIDEBAR_ENABLED 1
define HAL_PLUSCODE_ENABLED 1

define HAL_QUADPLANE_ENABLED 1
define QAUTOTUNE_ENABLED 1



